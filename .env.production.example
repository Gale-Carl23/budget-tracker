# Copy these into your hosting provider's environment/secret settings.
# Replace every example value with a real value for your deployment.
DJANGO_SECRET_KEY=generate-a-unique-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
# Uncomment only when your trusted hosting proxy sends this exact header/value:
# DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
DATABASE_URL=postgresql://user:password@host:5432/nibi
TIME_ZONE=Asia/Shanghai
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Nibi <no-reply@your-domain.example>
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=700
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_DAY=100
